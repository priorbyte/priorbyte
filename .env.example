# Copy to .env.local (web) / .env (backend) and fill in. Never commit real values.

# --- Supabase (step 2) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser or the extension.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web ---
# Used for magic-link redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (Phase 1 tutor / Phase 2 oracle) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Email + cron (Phase 3) ---
RESEND_API_KEY=
